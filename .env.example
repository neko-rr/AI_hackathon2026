# cp .env.example .env して編集（Gitにコミットしない）

# AWS（ローカル開発・CLI）
AWS_REGION=ap-northeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

# Bedrock（未使用時は空のまま）
# BEDROCK_MODEL_ID=

# アプリ公開 URL（デプロイ後に記入）
APP_URL=http://otameshi1.s3-website-ap-northeast-1.amazonaws.com/

# フロント → Lambda/API Gateway（ビルド時に Vite が読む。未設定ならデモ用フォールバック）
# ローカル開発: VITE_API_URL=/api/deliver
# 本番: VITE_API_URL=https://xxxx.execute-api.ap-northeast-1.amazonaws.com/prod/deliver
# VITE_API_URL=/api/deliver

# --- IO Intelligence（https://io.net/docs/guides/intelligence/api-keys-and-secrets）---
# IO ID ダッシュボードで API キーを発行
IO_INTELLIGENCE_API_KEY=

# テキスト Q&A（届いたアイデア）— 主モデル / フォールバック
IO_INTELLIGENCE_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
IO_INTELLIGENCE_FALLBACK_MODEL=mistralai/Mistral-Large-Instruct-2411

# 画像→テキスト（Vision・今回の作品では未使用）
# IO_INTELLIGENCE_VISION_MODEL=meta-llama/Llama-3.2-90B-Vision-Instruct
# IO_INTELLIGENCE_VISION_FALLBACK_MODEL=Qwen/Qwen2.5-VL-32B-Instruct

# Lambda 関数名（deploy-lambda.ps1 用・任意）
# LAMBDA_FUNCTION_NAME=hackathon-deliver
